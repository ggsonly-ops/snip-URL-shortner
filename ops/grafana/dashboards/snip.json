{
  "uid": "snip-overview",
  "title": "Snip — service overview",
  "tags": ["snip"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "snip-prom" },
        "query": "label_values(jvm_info, app_instance)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "1 — Request rate by endpoint",
      "description": "Requests per second, split by the matched URI template. The redirect route is /{code} and should dominate.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "snip-prom" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri) (rate(http_server_requests_seconds_count{app_instance=~\"$instance\"}[1m]))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "2 — Latency p50 / p95 / p99",
      "description": "Computed from summed histogram buckets across instances. Averaging each instance's percentile would be wrong: percentiles do not average.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "snip-prom" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 0, "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{app_instance=~\"$instance\"}[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{app_instance=~\"$instance\"}[1m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{app_instance=~\"$instance\"}[1m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "3 — Error rate (4xx vs 5xx)",
      "description": "Kept separate on purpose: 4xx is mostly clients asking for links that do not exist plus 429s from the rate limiter, which is the system working. 5xx is the system failing.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "snip-prom" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 20, "lineWidth": 1, "stacking": { "mode": "normal" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "5xx" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "429 rate limited" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "404 not found" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{app_instance=~\"$instance\",status=~\"5..\"}[1m]))",
          "legendFormat": "5xx"
        },
        {
          "refId": "B",
          "expr": "sum(rate(http_server_requests_seconds_count{app_instance=~\"$instance\",status=\"404\"}[1m]))",
          "legendFormat": "404 not found"
        },
        {
          "refId": "C",
          "expr": "sum(rate(snip_ratelimit_decision_total{app_instance=~\"$instance\",decision=\"blocked\"}[1m]))",
          "legendFormat": "429 rate limited"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "4 — Cache hit ratio  ⭐",
      "description": "The money graph. Ratio over a 1-minute window, derived from the hit/miss counters so it reacts to what is happening now rather than to process lifetime.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "snip-prom" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "fillOpacity": 15, "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.7 },
              { "color": "green", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(snip_cache_result_total{app_instance=~\"$instance\",outcome=\"hit\"}[1m])) / clamp_min(sum(rate(snip_cache_result_total{app_instance=~\"$instance\",outcome=~\"hit|miss\"}[1m])), 0.001)",
          "legendFormat": "hit ratio (1m)"
        },
        {
          "refId": "B",
          "expr": "avg(snip_cache_hit_ratio{app_instance=~\"$instance\"})",
          "legendFormat": "hit ratio (process lifetime)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "5 — Database connection pool",
      "description": "Active vs idle vs threads waiting. Pending above zero means requests are queueing for a connection — this is the first bottleneck that appears when scaling out.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "snip-prom" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "waiting for a connection" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "targets": [
        { "refId": "A", "expr": "sum(hikaricp_connections_active{app_instance=~\"$instance\"})", "legendFormat": "active" },
        { "refId": "B", "expr": "sum(hikaricp_connections_idle{app_instance=~\"$instance\"})", "legendFormat": "idle" },
        { "refId": "C", "expr": "sum(hikaricp_connections_pending{app_instance=~\"$instance\"})", "legendFormat": "waiting for a connection" },
        { "refId": "D", "expr": "sum(hikaricp_connections_max{app_instance=~\"$instance\"})", "legendFormat": "pool max" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "6 — JVM heap and GC pause",
      "description": "Heap used against committed, plus mean GC pause. GC pauses are a large part of where p99 comes from once p50 is in single-digit milliseconds.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "snip-prom" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "gc pause (mean)" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } }
            ]
          }
        ]
      },
      "targets": [
        { "refId": "A", "expr": "sum(jvm_memory_used_bytes{app_instance=~\"$instance\",area=\"heap\"})", "legendFormat": "heap used" },
        { "refId": "B", "expr": "sum(jvm_memory_committed_bytes{app_instance=~\"$instance\",area=\"heap\"})", "legendFormat": "heap committed" },
        {
          "refId": "C",
          "expr": "sum(rate(jvm_gc_pause_seconds_sum{app_instance=~\"$instance\"}[1m])) / clamp_min(sum(rate(jvm_gc_pause_seconds_count{app_instance=~\"$instance\"}[1m])), 0.001)",
          "legendFormat": "gc pause (mean)"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Redirect latency by outcome",
      "description": "p99 of the redirect path split by how it was served. The gap between 'hit' and 'miss' is the cache's whole value, visible directly.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "snip-prom" },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 0, "lineWidth": 2 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, outcome) (rate(snip_redirect_seconds_bucket{app_instance=~\"$instance\"}[1m])))",
          "legendFormat": "p99 {{outcome}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Async click pipeline",
      "description": "Events published to the stream against rows persisted, plus the pending-entries backlog. Published minus persisted converging on zero means the consumer is keeping up.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "snip-prom" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "lineWidth": 2 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(snip_clicks_published_total{app_instance=~\"$instance\",outcome=\"ok\"}[1m]))", "legendFormat": "published/s" },
        { "refId": "B", "expr": "sum(rate(snip_clicks_persisted_total{app_instance=~\"$instance\"}[1m]))", "legendFormat": "persisted/s" },
        { "refId": "C", "expr": "sum(rate(snip_clicks_published_total{app_instance=~\"$instance\",outcome=\"dropped\"}[1m]))", "legendFormat": "dropped/s" },
        { "refId": "D", "expr": "max(snip_analytics_stream_pending{app_instance=~\"$instance\"})", "legendFormat": "pending backlog" }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Cache hit ratio",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "snip-prom" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 0.7 }, { "color": "green", "value": 0.9 }] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(snip_cache_result_total{outcome=\"hit\"}[5m])) / clamp_min(sum(rate(snip_cache_result_total{outcome=~\"hit|miss\"}[5m])), 0.001)" }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Redirect p95",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "snip-prom" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.05 }, { "color": "red", "value": 0.25 }] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(snip_redirect_seconds_bucket[5m])))" }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Throughput",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "snip-prom" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum(rate(http_server_requests_seconds_count[1m]))" }]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Live instances",
      "description": "Drops when an instance dies. With Nginx's least_conn and proxy_next_upstream, traffic should continue with no error-rate change.",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "snip-prom" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "count(up{job=\"snip\"} == 1)" }]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Stampede lock and bloom filter",
      "description": "'acquired' is the single request that repopulates a hot key; 'waited' is everyone else who would otherwise have hit Postgres for the same row. Bloom rejects never touch Postgres at all.",
      "gridPos": { "h": 6, "w": 12, "x": 16, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "snip-prom" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 10, "lineWidth": 2 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (rate(snip_stampede_lock_total[1m]))", "legendFormat": "lock {{outcome}}/s" },
        { "refId": "B", "expr": "sum(rate(snip_bloom_reject_total[1m]))", "legendFormat": "bloom rejects/s" },
        { "refId": "C", "expr": "sum(rate(snip_cache_result_total{outcome=\"unavailable\"}[1m]))", "legendFormat": "redis unavailable/s" }
      ]
    }
  ]
}

# Copy to .env to override anything below. Docker Compose reads .env automatically.

# --- host port mappings ------------------------------------------------------
# Only needed if something else on your machine already owns these ports (another
# Postgres, another Redis, another service on :8080). Nothing inside the stack
# changes - these are host-side mappings only.
SNIP_HTTP_PORT=80
SNIP_APP1_PORT=8080
SNIP_APP2_PORT=8081
SNIP_APP3_PORT=8082
SNIP_DB_PORT=5432
SNIP_REDIS_PORT=6379
SNIP_PROMETHEUS_PORT=9090
SNIP_GRAFANA_PORT=3001

# --- application -------------------------------------------------------------
# Must match how you actually reach the service, since it is what gets returned
# as the short URL and encoded into QR codes.
APP_BASE_URL=http://localhost

# Feature switches. APP_CACHE_ENABLED=false is the load-test baseline.
APP_CACHE_ENABLED=true
APP_RATE_LIMIT_ENABLED=true
APP_BLOOM_ENABLED=true
APP_ANALYTICS_ENABLED=true

# HikariCP pool size per instance. 3 instances x 20 = 60 Postgres connections.
APP_DB_POOL_SIZE=20

# Redirect token bucket. Sized for a load test hitting from a handful of IPs;
# lower it to watch 429s appear.
APP_REDIRECT_CAPACITY=600
APP_REDIRECT_REFILL=600

# --- analytics ---------------------------------------------------------------
# Real country data needs a MaxMind GeoLite2-Country.mmdb, which cannot be
# redistributed. Mount one and point at it:
#   APP_GEOIP_DB=/app/GeoLite2-Country.mmdb
APP_GEOIP_DB=

# Demo only: derive a country from the client IP so the dashboard is not empty.
# The data is SYNTHETIC and the analytics API flags it as such. Off by default.
APP_GEOIP_DEMO=false
